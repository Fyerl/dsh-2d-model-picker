{
  "name": "dsh-model-matrix",
  "version": "0.1.0",
  "description": "A 2D model × reasoning-effort picker that replaces the DeepSeek Harness model selector.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "model",
    "reasoning",
    "effort",
    "matrix",
    "selector"
  ],
  "author": "Fyerl <ryan.fanyue@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fyerl/dsh-model-matrix.git"
  },
  "homepage": "https://github.com/Fyerl/dsh-model-matrix#readme",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
