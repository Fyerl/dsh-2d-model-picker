{
  "name": "dsh-2d-model-picker",
  "version": "0.1.1",
  "description": "A 2D model picker for DeepSeek Harness — select a model and reasoning effort in one drag.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "model",
    "reasoning",
    "effort",
    "2d",
    "picker",
    "selector"
  ],
  "author": "Fyerl <ryan.fanyue@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fyerl/dsh-2d-model-picker.git"
  },
  "homepage": "https://github.com/Fyerl/dsh-2d-model-picker#readme",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
